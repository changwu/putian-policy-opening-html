-font-family:仿宋_GB2312;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td width=3D108  valign=3Dcenter  style=3D"width:81.0000pt;padding:0.0000pt 5.4000pt 0.0000pt 5.4000pt ;border-left:none;mso-border-left-alt:none;border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3DMsoNormal  align=3Dcenter  style=3D"mso-layout-grid-align:none;layout-grid-mode:char;mso-pagination:widow-orphan;text-align:center;line-height:30.0000pt;mso-line-height-rule:exactly;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;mso-bidi-font-family:仿宋_GB2312;font-size:12.0000pt;mso-font-kerning:0.0000pt;" >财政核拨</span><span style=3D"font-family:宋体;mso-fareast-font-family:仿宋_GB2312;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td width=3D132  valign=3Dcenter  style=3D"width:99.0000pt;padding:0.0000pt 5.4000pt 0.0000pt 5.4000pt ;border-left:none;mso-border-left-alt:none;border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3DMsoNormal  align=3Dcenter  style=3D"mso-layout-grid-align:none;layout-grid-mode:char;mso-pagination:widow-orphan;text-align:center;line-height:30.0000pt;mso-line-height-rule:exactly;" ><span style=3D"font-family:宋体;mso-fareast-font-family:仿宋_GB2312;font-size:12.0000pt;mso-font-kerning:0.0000pt;" >4</span><span style=3D"font-family:宋体;mso-fareast-font-family:仿宋_GB2312;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td width=3D128  valign=3Dcenter  style=3D"width:96.7000pt;padding:0.0000pt 5.4000pt 0.0000pt 5.4000pt ;border-left:none;mso-border-left-alt:none;border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3DMsoNormal  align=3Dcenter  style=3D"mso-layout-grid-align:none;layout-grid-mode:char;mso-pagination:widow-orphan;text-align:center;line-height:30.0000pt;mso-line-height-rule:exactly;" ><span style=3D"font-family:宋体;mso-fareast-font-family:仿宋_GB2312;font-size:12.0000pt;mso-font-kerning:0.0000pt;" >1</span><span style=3D"font-family:宋体;mso-fareast-font-family:仿宋_GB2312;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr></table><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.1500pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >三、部门主要工作总结</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></p><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.0000pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" >2018</span><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >年以来，在莆田市委的正确领导和省委组织部的精心指导下，我们坚持以党的十八届三中、四中、五中、六中全会以及全国、全省组织工作会议精神为指导，找准定位、服务大局，深化改革、主动作为，积极推进组织工作创新发展，为建设宜业宜商宜居莆田提供有力的组织保证和人才支持。主要体现在：</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.1500pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >（一）教育实践活动富有成效。</font></span></b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >一是高站位谋划部署。二是多形式学习教育。三是全方位聚焦问题。四是严要求落实整改。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.1500pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >（二）选人用人导向更加鲜明。</font></span></b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >一是从实教育培养。二是从优配备选拔。三是从严监督管理。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.1500pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >（三）基层组织建设有效加强。</font></span></b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >一是强化主体责任。二是加快薄弱转化。三是推动创新转型。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.1500pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >（四）招才引智力度不断加大。</font></span></b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >一是搭建聚才平台。二是完善育才服务。三是优化留才环境。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.1500pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >（五）党的建设制度改革有序推进。</font></span></b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >一是推动党的组织制度改革。二是推动干部人事制度改革。三是推动基层组织制度改革。四是推动人才发展制度改革。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-left:0.0000pt;text-indent:32.1500pt;mso-char-indent-count:2.0000;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-weight:bold;font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >（六）自身建设水平持续提升。</font></span></b><span style=3D"mso-spacerun:'yes';font-family:仿宋_GB2312;mso-hansi-font-family:宋体;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"仿宋_GB2312" >一是注重制度规范。二是注重作风建设。三是注重干事环境。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;mso-fareast-font-family:仿宋_GB2312;color:rgb(51,51,51);font-size:16.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"mso-layout-grid-align:none;layout-grid-mode:char;mso-pagination:widow-orphan;line-height:30.0000pt;mso-line-height-rule:exactly;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;</span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></p><p class=3DMsoNormal  align=3Dcenter  style=3D"margin-top:0.0000pt;margin-right:0.0000pt;margin-bottom:5.0000pt;margin-left:0.0000pt;mso-margin-bottom-alt:auto;layout-grid-mode:char;mso-pagination:widow-orphan;text-align:center;" ><span style=3D"mso-spacerun:'yes';font-family:黑体;mso-hansi-font-family:宋体;font-size:18.0000pt;mso-font-kerning:0.0000pt;background:rgb(255,255,255);mso-shading:rgb(255,255,255);" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:黑体;mso-hansi-font-family:宋体;font-size:18.0000pt;mso-font-kerning:0.0000pt;background:rgb(255,255,255);mso-shading:rgb(255,255,255);" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top